# .env.example

BOT_TOKEN=your_max_bot_token_here

# Режим получения событий от MAX:
# — Если WEBHOOK_URL задан: используется Webhook (POST от MAX на /webhook).
# — Если WEBHOOK_URL пустой или не задан: Long Polling (сервис сам опрашивает GET /updates).
# Для Long Polling в кабинете MAX не должна быть подписка на Webhook.
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret_here

MAX_API_BASE_URL=https://platform-api.max.ru
