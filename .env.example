# .env.example

# Режим получения событий от MAX:
# — Если WEBHOOK_URL задан: используется Webhook (POST от MAX на /webhook).
# — Если WEBHOOK_URL пустой или не задан: Long Polling (сервис сам опрашивает GET /updates).
# Для Long Polling в кабинете MAX не должна быть подписка на Webhook.
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=your_webhook_secret_here

MAX_API_BASE_URL=https://platform-api.max.ru

# Порт HTTP-сервера (по умолчанию 8080)
# PORT=9003

# Опционально: секрет для доступа к /refresh-group-chats и /group-chats (заголовок X-API-Key)
# API_KEY=your_internal_api_key

# Лимит запросов в минуту для /send-message и /send-by-phone (0 = без лимита, по умолчанию 60)
# RATE_LIMIT_PER_MINUTE=60

# Таймаут завершения HTTP-сервера при остановке, секунды (0 = 10 с)
# SHUTDOWN_TIMEOUT_SEC=10

# Логирование: уровень (debug|info|warn|error) и формат (text|json)
# LOG_LEVEL=info
# LOG_FORMAT=text
